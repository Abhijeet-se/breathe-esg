# ============================================
# Breathe ESG — Environment Variables
# ============================================
# Copy this file to .env and fill in values:
#   cp .env.example .env
# ============================================

# Django Settings
# ---------------
DJANGO_SECRET_KEY=change-me-to-a-random-string-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database
# --------
# Leave empty to use SQLite (development default)
# Set to PostgreSQL connection string for production:
# DATABASE_URL=postgres://user:password@host:5432/dbname
DATABASE_URL=

# CORS
# ----
# Frontend URL(s) allowed to make API requests
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT Token Lifetimes
# --------------------
ACCESS_TOKEN_LIFETIME_MINUTES=30
REFRESH_TOKEN_LIFETIME_DAYS=7

# File Upload
# -----------
MAX_UPLOAD_SIZE_MB=50

# Frontend (Vite)
# ---------------
VITE_API_URL=http://localhost:8000/api
